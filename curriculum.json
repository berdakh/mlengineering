{
  "title": "Applied ML Engineering",
  "audience": "Students who have taken an introductory machine-learning course (for example Learning from Data) and can program in basic Python, but have no industry tool experience: no SQL, Git, testing, APIs, Docker or cloud.",
  "weeks": [
    {"week": 1, "title": "Your engineering workbench", "goal": "work confidently in Colab, write clean Python, and use the terminal and Git"},
    {"week": 2, "title": "SQL from zero", "goal": "answer business questions from a relational database with SELECT, GROUP BY and JOIN"},
    {"week": 3, "title": "Advanced SQL and pandas", "goal": "use window functions and CTEs, do the same work in pandas, and clean messy data with quality checks"},
    {"week": 4, "title": "From data to features", "goal": "explore a dataset with purpose and turn it into features with scikit-learn pipelines"},
    {"week": 5, "title": "From theory to practice: framing, baselines, metrics", "goal": "frame a business problem as an ML task, beat honest baselines, and pick metrics and thresholds from costs"},
    {"week": 6, "title": "Validation and leakage", "goal": "validate the way the model will be used and find leakage before it fools you"},
    {"week": 7, "title": "Models, uncertainty and error analysis", "goal": "compare models fairly with uncertainty, analyse errors, and start the project"},
    {"week": 8, "title": "Code you can trust", "goal": "turn notebook code into a tested, configurable Python package"},
    {"week": 9, "title": "Serving models", "goal": "save models safely and serve predictions through a tested FastAPI service"},
    {"week": 10, "title": "Containers and CI", "goal": "set up VS Code locally, run the service in Docker, and test every push with GitHub Actions"},
    {"week": 11, "title": "Deploy and operate", "goal": "deploy safely, log and monitor a model, and tell input drift from real degradation"},
    {"week": 12, "title": "Capstone and career", "goal": "finish and present the project, and practise for interviews"}
  ],
